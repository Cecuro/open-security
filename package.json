{
  "name": "opensec",
  "version": "0.0.0",
  "description": "Point it at a repository, get real security findings with file:line, evidence, and a severity you can defend — using any model you want, on your own machine.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "opensec": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "prompts",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run",
    "opensec": "node dist/cli/index.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.0",
    "better-sqlite3": "13.0.3",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
